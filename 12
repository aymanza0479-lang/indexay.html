<!DOCTYPE html>
<html lang="ar" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CASIO fx-991ES PLUS - Pro Edition</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            background-color: #1a1a1a;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 10px;
        }

        /* الحاوية الجديدة لتجميع الآلة والشريط الجانبي بجانب بعض */
        .calculator-wrapper {
            display: flex;
            gap: 15px;
            align-items: flex-start;
            justify-content: center;
            flex-wrap: wrap;
        }

        .calculator {
            background-color: #222225;
            width: 100%;
            max-width: 360px;
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
            border: 2px solid #444;
        }

        /* تنسيق الشريط الجانبي لتفصيل العمليات */
        .side-tape {
            background-color: #222225;
            color: #fff;
            padding: 15px;
            border-radius: 15px;
            width: 240px;
            min-height: 400px;
            max-height: 520px;
            overflow-y: auto;
            font-family: monospace;
            border: 2px solid #444;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8);
        }

        .side-tape h4 {
            font-size: 13px;
            color: #d4a373;
            margin-bottom: 10px;
            text-align: center;
            border-bottom: 1px solid #444;
            padding-bottom: 5px;
        }

        .side-tape ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .side-tape li {
            padding: 6px 0;
            border-bottom: 1px dashed #333;
            display: flex;
            justify-content: space-between;
            font-size: 13px;
        }

        .side-tape li span {
            color: #bbb;
        }

        .side-tape li strong {
            color: #52b788;
        }

        .brand-header {
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 15px;
            padding: 0 5px;
        }

        .brand-header h1 {
            font-size: 22px;
            font-weight: 900;
            letter-spacing: 1px;
            color: #fff;
        }

        .brand-header span {
            font-size: 10px;
            color: #bbb;
        }

        .screen {
            background-color: #c4d7b2;
            border-radius: 6px;
            padding: 8px 10px;
            margin-bottom: 15px;
            border: 3px inset #88987b;
            min-height: 75px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .screen-header-line {
            display: flex;
            justify-content: space-between;
            font-size: 11px;
            font-weight: bold;
            color: #222;
            min-height: 15px;
        }

        .memory-indicator {
            color: #900;
            display: none;
        }

        .screen-top {
            font-size: 14px;
            color: #333;
            text-align: right;
            min-height: 20px;
            overflow-x: auto;
            white-space: nowrap;
            scrollbar-width: none;
        }

        .screen-top::-webkit-scrollbar {
            display: none;
        }

        .screen-main {
            font-size: 26px;
            font-weight: bold;
            color: #111;
            text-align: right;
            overflow-x: auto;
            white-space: nowrap;
            scrollbar-width: none;
        }

        .screen-main::-webkit-scrollbar {
            display: none;
        }

        .buttons-grid {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 6px;
        }

        button {
            padding: 12px 0;
            font-size: 13px;
            font-weight: bold;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            color: #fff;
            transition: 0.05s;
            box-shadow: 0 3px #111;
            user-select: none;
        }

        button:active {
            transform: translateY(2px);
            box-shadow: 0 1px #111;
        }

        .btn-dark { background-color: #333338; color: #eee; }
        .btn-gray { background-color: #55555d; color: #fff; }
        .btn-shift { background-color: #d4a373; color: #000; }
        .btn-alpha { background-color: #bc4749; color: #fff; }
        .btn-op { background-color: #e65f2b; color: #fff; }
        .btn-equals { background-color: #1d3557; color: #fff; }
        .btn-mem { background-color: #7b2cbf; color: #fff; }
    </style>
    <link rel="icon" type="image/png" href="icon.png">
    <link rel="apple-touch-icon" href="icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
</head>
<body>

    <div class="calculator-wrapper">
        <!-- جسم الآلة الحاسبة -->
        <div class="calculator">
            <div class="brand-header">
                <h1>CASIO</h1>
                <span>fx-991ES PLUS NATURAL-V.P.A.M.</span>
            </div>

            <div class="screen">
                <div class="screen-header-line">
                    <span class="memory-indicator" id="memIndicator">M</span>
                    <span id="modeIndicator"></span>
                </div>
                <div class="screen-top" id="screenTop">0</div>
                <div class="screen-main" id="screenMain">0</div>
            </div>

            <div class="buttons-grid">
                <!-- Row 1 -->
                <button class="btn-shift" onclick="pressKey('SHIFT')">SHIFT</button>
                <button class="btn-alpha" onclick="pressKey('ALPHA')">ALPHA</button>
                <button class="btn-dark" onclick="pressKey('UP')">▲</button>
                <button class="btn-dark" onclick="pressKey('DOWN')">▼</button>
                <button class="btn-op" onclick="deleteChar()">DEL</button>

                <!-- Row 2 -->
                <button class="btn-dark" onclick="pressKey('MODE')">MODE</button>
                <button class="btn-dark" onclick="pressKey('CALC')">CALC</button>
                <button class="btn-dark" onclick="pressKey('SOLVE')">SOLVE</button>
                <button class="btn-dark" onclick="pressKey('ENG')">ENG</button>
                <button class="btn-dark" onclick="clearAll()">AC</button>

                <!-- Row 3 -->
                <button class="btn-gray" onclick="appendValue('sin(')">sin</button>
                <button class="btn-gray" onclick="appendValue('cos(')">cos</button>
                <button class="btn-gray" onclick="appendValue('tan(')">tan</button>
                <button class="btn-gray" onclick="appendValue('Math.sqrt(')">√</button>
                <button class="btn-gray" onclick="appendValue('**2')">x²</button>

                <!-- Row 4 -->
                <button class="btn-gray" onclick="appendValue('Math.log10(')">log</button>
                <button class="btn-gray" onclick="appendValue('Math.log(')">ln</button>
                <button class="btn-gray" onclick="appendValue('/')">a b/c</button>
                <button class="btn-gray" onclick="appendValue('(')">(</button>
                <button class="btn-gray" onclick="appendValue(')')">)</button>

                <!-- Row 5 -->
                <button class="btn-dark" onclick="appendValue('7')">7</button>
                <button class="btn-dark" onclick="appendValue('8')">8</button>
                <button class="btn-dark" onclick="appendValue('9')">9</button>
                <button class="btn-dark" onclick="pressKey('ON')">ON</button>
                <button class="btn-op" onclick="appendValue('÷')">÷</button>

                <!-- Row 6 -->
                <button class="btn-dark" onclick="appendValue('4')">4</button>
                <button class="btn-dark" onclick="appendValue('5')">5</button>
                <button class="btn-dark" onclick="appendValue('6')">6</button>
                <button class="btn-op" onclick="appendValue('×')">×</button>
                <button class="btn-op" onclick="appendValue('-')">-</button>

                <!-- Row 7 -->
                <button class="btn-dark" onclick="appendValue('1')">1</button>
                <button class="btn-dark" onclick="appendValue('2')">2</button>
                <button class="btn-dark" onclick="appendValue('3')">3</button>
                <button class="btn-op" onclick="appendValue('+')">+</button>
                <button class="btn-equals" onclick="calculateResult()" style="grid-row: span 2;">=</button>

                <!-- Row 8 -->
                <button class="btn-dark" onclick="appendValue('0')">0</button>
                <button class="btn-dark" onclick="appendValue('.')">.</button>
                <button class="btn-dark" onclick="appendValue('Math.PI')">π</button>
                <button class="btn-dark" onclick="useAns()">Ans</button>

                <!-- Row 9: Memory Buttons -->
                <button class="btn-mem" onclick="memClear()">MC</button>
                <button class="btn-mem" onclick="memRecall()">MR</button>
                <button class="btn-mem" onclick="memAdd()">M+</button>
                <button class="btn-mem" onclick="memSub()">M-</button>
                <button class="btn-mem" onclick="memStore()">STO</button>
            </div>
        </div>

        <!-- الشريط الجانبي لعرض تفصيل العمليات وقتي -->
        <div class="side-tape">
            <h4>تفصيل العمليات</h4>
            <ul id="breakdownList">
                <!-- سيتم ملء التفاصيل هنا تلقائياً -->
            </ul>
        </div>
    </div>

    <script>
        let currentInput = "";
        let memory = 0;
        let hasMemory = false;
        let ans = 0;
        let justCalculated = false;

        const screenMain = document.getElementById("screenMain");
        const screenTop = document.getElementById("screenTop");
        const memIndicator = document.getElementById("memIndicator");
        const breakdownList = document.getElementById("breakdownList");

        function updateScreen() {
            screenTop.innerText = currentInput || "0";
            
            // التمرير التلقائي لأقصى اليمين مع كل إدخال جديد
            screenTop.scrollLeft = screenTop.scrollWidth;
            screenMain.scrollLeft = screenMain.scrollWidth;

            if (hasMemory) {
                memIndicator.style.display = "inline";
            } else {
                memIndicator.style.display = "none";
            }
        }

        // دالة الحساب الفوري وتوليد تفصيل الشريط الجانبي
        function calculateLive(expression) {
            breakdownList.innerHTML = '';
            if (!expression) {
                screenMain.innerText = "0";
                return;
            }

            // تحويل الرموز لرموز JavaScript صحيحة للحساب
            let mathExp = expression.replace(/×/g, '*').replace(/÷/g, '/');
            let cleanExp = mathExp.replace(/[+\-*/.]$/, ''); // إزالة العلامات الزائدة في النهاية مؤقتاً

            // 1. تقسيم المعادلة عند الـ + والـ - لعرض ناتج العمليات الفرعية (مثل الضرب والقسمة) على جنب
            let parts = cleanExp.split(/(?=[+-])/);
            parts.forEach(part => {
                let trimmed = part.trim();
                if (trimmed) {
                    try {
                        let partRes = Function('"use strict";return (' + trimmed + ')')();
                        if (!isNaN(partRes)) {
                            let displayPart = trimmed.replace(/\*/g, '×').replace(/\//g, '÷');
                            let li = document.createElement('li');
                            li.innerHTML = `<span>${displayPart}</span> <strong>= ${partRes}</strong>`;
                            breakdownList.appendChild(li);
                        }
                    } catch (e) {}
                }
            });

            // 2. حساب الناتج النهائي الفوري وعرضه في الشاشة الرئيسية
            try {
                let total = Function('"use strict";return (' + cleanExp + ')')();
                if (!isNaN(total) && isFinite(total)) {
                    screenMain.innerText = total;
                }
            } catch (e) {
                // الحفاظ على العرض في حال كتابة تعبير غير مكتمل مؤقتاً
            }
        }

        function appendValue(val) {
            if (justCalculated) {
                // إذا كتبنا رقم جديد بعد اليساوي، نبدأ معادلة جديدة. لو كتبنا عملية (+ أو -) نكمل على الـ Ans
                if (!['+', '-', '×', '÷'].includes(val)) {
                    currentInput = "";
                }
                justCalculated = false;
            }

            currentInput += val;
            updateScreen();
            calculateLive(currentInput);
        }

        function clearAll() {
            currentInput = "";
            justCalculated = false;
            breakdownList.innerHTML = '';
            screenMain.innerText = "0";
            updateScreen();
        }

        function deleteChar() {
            if (justCalculated) return;
            if (currentInput.length > 0) {
                currentInput = currentInput.slice(0, -1);
            }
            updateScreen();
            calculateLive(currentInput);
        }

        function calculateResult() {
            try {
                let mathExp = currentInput.replace(/×/g, '*').replace(/÷/g, '/');
                let result = Function('"use strict";return (' + mathExp + ')')();
                
                ans = result;
                screenMain.innerText = result;
                currentInput = String(result);
                justCalculated = true;
                updateScreen();
            } catch (error) {
                screenMain.innerText = "Math Error";
                setTimeout(clearAll, 1500);
            }
        }

        function useAns() {
            appendValue(String(ans));
        }

        // --- دوال الذاكرة ---
        function memClear() {
            memory = 0;
            hasMemory = false;
            updateScreen();
        }

        function memRecall() {
            appendValue(String(memory));
        }

        function memAdd() {
            try {
                let mathExp = currentInput.replace(/×/g, '*').replace(/÷/g, '/');
                memory += Function('"use strict";return (' + mathExp + ')')();
                hasMemory = true;
                updateScreen();
            } catch {}
        }

        function memSub() {
            try {
                let mathExp = currentInput.replace(/×/g, '*').replace(/÷/g, '/');
                memory -= Function('"use strict";return (' + mathExp + ')')();
                hasMemory = true;
                updateScreen();
            } catch {}
        }

        function memStore() {
            try {
                let mathExp = currentInput.replace(/×/g, '*').replace(/÷/g, '/');
                memory = Function('"use strict";return (' + mathExp + ')')();
                hasMemory = true;
                updateScreen();
            } catch {}
        }

        function pressKey(keyName) {
            if(keyName === 'ON') clearAll();
        }

        // --- دعم لوحة المفاتيح ---
        document.addEventListener('keydown', function(event) {
            const key = event.key;
            
            if (!isNaN(key) || key === '.') {
                appendValue(key);
            } else if (key === '+') {
                appendValue('+');
            } else if (key === '-') {
                appendValue('-');
            } else if (key === '*') {
                appendValue('×');
            } else if (key === '/') {
                event.preventDefault();
                appendValue('÷');
            } else if (key === 'Enter' || key === '=') {
                calculateResult();
            } else if (key === 'Backspace') {
                deleteChar();
            } else if (key === 'Escape' || key === 'Delete') {
                clearAll();
            }
        });
    </script>
</body>
</html>
